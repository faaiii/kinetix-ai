# =============================================================================
# KINETIX ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate with your own service keys.
# Never commit .env.local or production credentials to source control.
# =============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 1. DATABASE & AUTHENTICATION (Supabase)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database Connection (Neon / Supabase Postgres)
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# 2. LLM PROVIDER API KEYS (At least one required for live generation)
# -----------------------------------------------------------------------------
# Primary LLM API Key (API Gateway / Provider)
AI_GATEWAY_API_KEY=""

# -----------------------------------------------------------------------------
# 3. PAYMENTS & BILLING (Stripe Test Mode)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Price IDs
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_TEAM_MONTHLY_PRICE_ID="price_..."

# -----------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL (Resend / Postmark - Optional)
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Kinetix <notifications@yourdomain.com>"
